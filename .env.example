# Copia este archivo como .env y rellena las contraseñas.
# El archivo .env está en .gitignore: no lo subas al repositorio.
#
# Genera cada contraseña con:
#   openssl rand -base64 24
#
# Las contraseñas están vacías a propósito: docker compose no arranca
# hasta que las rellenes.

# PostgreSQL (usuario postgres)
POSTGRES_PASSWORD=

# MongoDB (usuario administrador que se crea en el primer arranque)
MONGO_USER=valenbisi
MONGO_PASSWORD=
